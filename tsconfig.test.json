{
  // Typecheck-only config covering the files tsconfig.json leaves out.
  // tsconfig.json drives the build, so it is limited to src/ with rootDir src;
  // tests and scripts still need type checking and editor support.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "."
  },
  // `exclude` is inherited and filters `include`, so the base config's
  // "tests" entry has to be overridden or nothing here gets checked.
  "exclude": ["node_modules", "dist"],
  "include": ["src/**/*", "tests/**/*", "scripts/**/*"]
}
