{
  "name": "xenblocks-airdrop",
  "version": "2.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun src/index.ts",
    "status": "bun src/status.ts",
    "release-lock": "bun src/release-lock.ts",
    "build": "tsc",
    "build:program": "anchor build",
    "start": "bun dist/index.js",
    "lint": "eslint src/ tests/ scripts/",
    "lint:fix": "eslint src/ tests/ scripts/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "bun run checks",
    "checks": "bun run lint && bun run format:check && bun run typecheck && bun run test"
  },
  "author": "",
  "license": "ISC",
  "description": "XNM token airdrop script with on-chain tracking and delta calculations",
  "dependencies": {
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3"
  },
  "overrides": {
    "ws": "^8.21.3",
    "uuid": "^11.1.1",
    "brace-expansion": "^5.0.6",
    "flatted": "^3.4.0",
    "picomatch": "^4.0.4"
  },
  "devDependencies": {
    "@anchor-lang/core": "^1.1.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
